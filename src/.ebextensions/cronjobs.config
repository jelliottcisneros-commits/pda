files:
    "/etc/cron.d/mycron":
        mode: "000644"
        owner: root
        group: root
        content: |
            0 0 * * * source /opt/python/run/venv/bin/activate && source /opt/python/current/env && cd /opt/python/current/app/ && python manage.py clearsessions
commands:
    remove_old_cron:
        command: "rm -f /etc/cron.d/mycron.bak"
