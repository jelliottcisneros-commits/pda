# Local development example. Copy this file to .env in this directory.
ENV=testing

# Local email prints messages to the console instead of sending SMTP email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
FROM_EMAIL=local@example.com
DEFAULT_FROM_EMAIL=local@example.com
SERVER_EMAIL=local@example.com
BCC_EMAIL=local@example.com
EMAIL_TIMEOUT=10
ERROR_REPORT_EMAIL=local@example.com
SEND_PDF_EMAIL=OFF
SCHEDULING_URL=

# Dummy local values. Production must supply real AWS settings through the environment.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_STORAGE_BUCKET_NAME=local-pda
AWS_S3_REGION_NAME=us-east-1

PROTOCOL=http

# Production-only examples. Keep these disabled for local development.
# APP_URL=example.com
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS must include the scheme on modern Django.
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# RDS_DB_NAME=ebdb
# RDS_USERNAME=example
# RDS_PASSWORD=example
# RDS_HOSTNAME=example.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=example
# EMAIL_HOST_PASSWORD=example
# EMAIL_USE_TLS=True
# FROM_EMAIL=verified-sender@example.com
# DEFAULT_FROM_EMAIL=verified-sender@example.com
# SERVER_EMAIL=verified-sender@example.com
# BCC_EMAIL=verified-copy@example.com
# EMAIL_TIMEOUT=10
# SCHEDULING_URL=https://example.com/schedule
# PAYPAL_RECEIVER_EMAIL=example-paypal-business@example.com
# PAYPAL_RECIEVER_EMAIL=example-paypal-business@example.com  # Legacy misspelled alias.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
